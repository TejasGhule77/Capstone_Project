# ==============================================================================
# AgriIntel Configuration Template
# Copy this file to .env and adjust variables for your deployment environment
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
DEMO_MODE=false

# OpenWeatherMap API Key (Optional: fallbacks to Open-Meteo free agromet proxy)
OPENWEATHER_API_KEY=

# Database Connection (Default SQLite file inside data directory)
# For SQLite:
DATABASE_URL=sqlite:///data/agriintel.db
# For PostgreSQL (Production):
# DATABASE_URL=postgresql+psycopg2://agri_user:strong_password@postgres:5432/agriintel_prod

# Pesticide Inventory & OCR Settings
OCR_PROVIDER=tesseract
MAX_PESTICIDE_IMAGE_SIZE_MB=10
ENABLE_INVENTORY_BLOCKCHAIN=true
COMPARISON_SCORE_THRESHOLD=5.0

# Security & CORS (Use comma-separated origins or explicit domains in production)
# In production, replace * with your verified frontend domain:
# CORS_ORIGINS=["https://app.agriintel.com", "https://agriintel.vercel.app"]
